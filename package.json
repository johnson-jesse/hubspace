{
  "name": "hubspace",
  "type": "module",
  "private": true,
  "author": "Jesse A Johnson",
  "description": "Hubspace is a realtime web application demonstrating authenticated multiplayer-style communication using Node.js, Express, SQLite, and WebSockets. Users can create accounts, authenticate securely, and connect to a shared live environment where client state is synchronized instantly across connected sessions.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:check": "bun src/db/check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.21.1"
  }
}
